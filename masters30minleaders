<!doctype html> <html lang="en"> <head> <meta charset="utf-8"/> <meta name="viewport" content="width=device-width,initial-scale=1"/> <title>30-min Ergo Calculator</title> <script src="https://cdn.tailwindcss.com"></script> </head> <body class="bg-neutral-50 text-neutral-900"> <div id="root"></div> <!-- React + Babel (for JSX in one file) --> <script crossorigin src="https://unpkg.com/react@18/umd/react.development.js"></script> <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script> <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script> <script type="text/babel"> const { useState, useMemo } = React; // Utils const clamp = (n, min, max) => Math.min(Math.max(n, min), max); const round = (n, dp=1) => !isFinite(n) ? 0 : Math.round(n * 10**dp) / 10**dp; // Core formulas function paceFromDistance(distanceMeters) { return distanceMeters > 0 ? 900000 / distanceMeters : 0; } // s/500 over 30:00 function wattsFromPace(p) { if (!p) return 0; const r = 500 / p; return 2.8 * r*r*r; } function mmss(sec) { if (!isFinite(sec) || sec <= 0) return "-"; const m = Math.floor(sec/60); const s = (sec - m*60).toFixed(1).padStart(4,"0"); return `${m}:${s}`; } function computeMetrics({ distance, weight, spm }) { const paceSec = paceFromDistance(distance); const watts = wattsFromPace(paceSec); const wkg = weight > 0 ? watts / weight : 0; const jPerStroke = spm > 0 ? (watts * 60) / spm : 0; const srScore = weight > 0 ? jPerStroke / weight : 0; return { paceSec, paceStr: mmss(paceSec), watts, wkg, jPerStroke, srScore }; } const seedRows = [ { name: "Alex", distance: 7000, weight: 90, spm: 20 }, { name: "Beth", distance: 7500, weight: 80, spm: 22 }, { name: "Chris", distance: 8000, weight: 75, spm: 26 }, { name: "Dana", distance: 8200, weight: 65, spm: 28 }, { name: "Evan", distance: 8500, weight: 70, spm: 30 }, ]; function Stat({ label, value, sub }) { return ( <div className="rounded-2xl border p-3 shadow-sm bg-white"> <div className="text-[11px] uppercase tracking-wide opacity-70">{label}</div> <div className="text-xl font-semibold">{value}</div> <div className="text-[11px] opacity-60">{sub}</div> </div> ); } function Th({ children, onClick, active, dir }) { return ( <th onClick={onClick} className={`py-2 pr-3 text-xs uppercase tracking-wide opacity-70 cursor-pointer select-none ${active ? 'text-black' : ''}`}> <span className="inline-flex items-center gap-1"> {children} {active && <span className="text-[10px]">{dir === 'asc' ? '▲' : '▼'}</span>} </span> </th> ); } const Td = ({ children }) => <td className="py-2 pr-3">{children}</td>; function App() { const [name, setName] = useState(""); const [distance, setDistance] = useState(8000); const [weight, setWeight] = useState(75); const [spm, setSpm] = useState(26); const [rows, setRows] = useState(seedRows); const [sortKey, setSortKey] = useState("srScore"); // name|distance|paceSec|watts|wkg|jPerStroke|srScore|spm|weight const [sortDir, setSortDir] = useState("desc"); // asc|desc const live = useMemo(() => computeMetrics({ distance, weight, spm }), [distance, weight, spm]); function addRow() { const d = clamp(Number(distance), 5000, 12000); const w = clamp(Number(weight), 40, 140); const r = clamp(Number(spm), 12, 50); const n = (name || "").trim() || "—"; setRows(prev => [{ name: n, distance: d, weight: w, spm: r }, ...prev]); } function clearRows() { setRows([]); } const computedRows = useMemo(() => rows.map(r => ({ ...r, m: computeMetrics(r) })), [rows]); function valueFor(row) { switch (sortKey) { case "name": return (row.name || "").toLowerCase(); case "distance": return row.distance; case "spm": return row.spm; case "weight": return row.weight; case "paceSec": return row.m.paceSec; case "watts": return row.m.watts; case "wkg": return row.m.wkg; case "jPerStroke": return row.m.jPerStroke; case "srScore": default: return row.m.srScore; } } const sortedRows = useMemo(() => { const arr = [...computedRows]; arr.sort((a, b) => { const va = valueFor(a), vb = valueFor(b); if (typeof va === "string" || typeof vb === "string") { const cmp = String(va).localeCompare(String(vb)); return sortDir === "asc" ? cmp : -cmp; } if (va < vb) return sortDir === "asc" ? -1 : 1; if (va > vb) return sortDir === "asc" ? 1 : -1; return 0; }); return arr; }, [computedRows, sortKey, sortDir]); function clickSort(newKey) { if (newKey === sortKey) setSortDir(d => d === "asc" ? "desc" : "asc"); else { setSortKey(newKey); setSortDir("desc"); } } return ( <div className="w-full max-w-6xl mx-auto p-6"> <div className="mb-6"> <h1 className="text-2xl font-semibold tracking-tight">30-min Ergo Calculator</h1> <p className="text-sm opacity-80">Enter name, distance (m), body mass (kg), and stroke rate (spm). We compute pace/500m, watts, W/kg, J/stroke, and an SR efficiency score (J/kg/stroke). Sort by any metric.</p> </div> <div className="grid grid-cols-1 sm:grid-cols-4 gap-4 mb-4"> <div className="bg-white rounded-2xl shadow p-4"> <label className="block text-xs uppercase tracking-wide opacity-70 mb-1">Athlete name</label> <input type="text" value={name} onChange={e => setName(e.target.value)} placeholder="e.g., Drew" className="w-full rounded-xl border px-3 py-2"/> <p className="text-xs opacity-60 mt-1">Optional</p> </div> <div className="bg-white rounded-2xl shadow p-4"> <label className="block text-xs uppercase tracking-wide opacity-70 mb-1">Distance (m) in 30:00</label> <input type="number" min="5000" max="12000" value={distance} onChange={e => setDistance(Number(e.target.value))} className="w-full rounded-xl border px-3 py-2"/> <p className="text-xs opacity-60 mt-1">Typical range 6500–9000</p> </div> <div className="bg-white rounded-2xl shadow p-4"> <label className="block text-xs uppercase tracking-wide opacity-70 mb-1">Body mass (kg)</label> <input type="number" min="40" max="140" value={weight} onChange={e => setWeight(Number(e.target.value))} className="w-full rounded-xl border px-3 py-2"/> <p className="text-xs opacity-60 mt-1">For W/kg & SR score</p> </div> <div className="bg-white rounded-2xl shadow p-4"> <label className="block text-xs uppercase tracking-wide opacity-70 mb-1">Stroke rate (spm)</label> <input type="number" min="12" max="50" value={spm} onChange={e => setSpm(Number(e.target.value))} className="w-full rounded-xl border px-3 py-2"/> <p className="text-xs opacity-60 mt-1">Average across 30:00</p> </div> </div> <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 mb-4"> <Stat label="Pace /500m" value={live.paceStr} sub={`${round(live.paceSec,1)} s`} /> <Stat label="Watts" value={`${round(live.watts,1)}`} sub="Concept2 formula" /> <Stat label="W/kg" value={`${round(live.wkg,3)}`} sub={`${round(live.watts,1)} W / ${weight} kg`} /> <Stat label="J/stroke" value={`${round(live.jPerStroke,1)}`} sub="(W*60)/spm" /> <Stat label="SR Score" value={`${round(live.srScore,3)}`} sub="J/stroke ÷ kg" /> <Stat label="Inputs" value={`${distance} m`} sub={`${weight} kg • ${spm} spm`} /> </div> <div className="flex flex-wrap gap-2 mb-4 items-center"> <button onClick={addRow} className="px-4 py-2 rounded-xl bg-black text-white shadow">Add to table</button> <button onClick={clearRows} className="px-4 py-2 rounded-xl border">Clear table</button> <div className="ml-auto flex gap-2 items-center"> <label className="text-xs opacity-70">Sort by</label> <select className="border rounded-md px-2 py-1 text-sm" value={sortKey} onChange={e => setSortKey(e.target.value)}> <option value="srScore">SR Score</option> <option value="jPerStroke">J/stroke</option> <option value="wkg">W/kg</option> <option value="watts">Watts</option> <option value="paceSec">Pace (/500s)</option> <option value="distance">Distance</option> <option value="spm">Stroke rate</option> <option value="weight">Weight</option> <option value="name">Name</option> </select> <select className="border rounded-md px-2 py-1 text-sm" value={sortDir} onChange={e => setSortDir(e.target.value)}> <option value="desc">Desc</option> <option value="asc">Asc</option> </select> </div> </div> <div className="overflow-x-auto"> <table className="w-full text-sm"> <thead> <tr className="text-left border-b"> <Th onClick={() => clickSort("name")} active={sortKey==="name"} dir={sortDir}>Name</Th> <Th onClick={() => clickSort("distance")} active={sortKey==="distance"} dir={sortDir}>Distance (m)</Th> <Th onClick={() => clickSort("paceSec")} active={sortKey==="paceSec"} dir={sortDir}>Pace (/500m)</Th> <Th onClick={() => clickSort("watts")} active={sortKey==="watts"} dir={sortDir}>Watts</Th> <Th onClick={() => clickSort("spm")} active={sortKey==="spm"} dir={sortDir}>SR (spm)</Th> <Th onClick={() => clickSort("weight")} active={sortKey==="weight"} dir={sortDir}>Weight (kg)</Th> <Th onClick={() => clickSort("wkg")} active={sortKey==="wkg"} dir={sortDir}>W/kg</Th> <Th onClick={() => clickSort("jPerStroke")} active={sortKey==="jPerStroke"} dir={sortDir}>J/stroke</Th> <Th onClick={() => clickSort("srScore")} active={sortKey==="srScore"} dir={sortDir}>SR Score (J/kg/st)</Th> </tr> </thead> <tbody> {sortedRows.map((r, i) => ( <tr key={i} className="border-b hover:bg-black/5"> <Td>{r.name}</Td> <Td>{r.distance}</Td> <Td>{r.m.paceStr}</Td> <Td>{round(r.m.watts,1)}</Td> <Td>{r.spm}</Td> <Td>{r.weight}</Td> <Td>{round(r.m.wkg,3)}</Td> <Td>{round(r.m.jPerStroke,1)}</Td> <Td>{round(r.m.srScore,3)}</Td> </tr> ))} </tbody> </table> </div> <div className="mt-6 text-xs opacity-70"> <p><span className="font-medium">Formulas:</span> pace(s/500)=900000÷distance(m); watts=2.80×(500/pace)^3; W/kg=watts÷kg; J/str=(watts×60)÷spm; SR Score=J/str÷kg.</p> <p className="mt-1"><span className="font-medium">Coach’s note (opinion):</span> Lift metres without letting SR Score slide—more boat per stroke, not just more strokes.</p> </div> </div> ); } ReactDOM.createRoot(document.getElementById('root')).render(<App />); </script> </body> </html>
